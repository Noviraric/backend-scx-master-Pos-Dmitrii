# Скопируйте в .env и заполните. .env в .gitignore — секреты в репозиторий не попадают.
APP_NAME="Task Tracker API"
DEBUG=True

# База данных (асинхронные драйверы). SQLite: sqlite+aiosqlite:///./tasks.db
DATABASE_URL="postgresql+asyncpg://task_tracker:change-me@localhost:5432/task_tracker"

# JWT
SECRET_KEY=change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# S3 (локально: docker-контейнер pgsty/silo, см. README)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=change-me
S3_BUCKET=task-avatars
S3_REGION=us-east-1
